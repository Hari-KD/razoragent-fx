# Razorpay Sandbox Credentials
# Get these from: https://dashboard.razorpay.com/apikeys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx

# OpenAI API Key (Optional)
# Get from: https://platform.openai.com/api-keys
# If not provided, the system uses a deterministic fallback engine that still provides intelligent routing
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# Razorpay Webhook Secret (Optional)
# Get from: https://dashboard.razorpay.com/settings/webhooks
# Required for production webhook signature verification
# For local testing, you can use ngrok to expose your localhost
RAZORPAY_WEBHOOK_SECRET=whsec_xxxx
